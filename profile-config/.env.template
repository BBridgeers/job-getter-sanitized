# ─────────────────────────────────────────────
# Job Getter Profile — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env — it contains secrets.

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id
TELEGRAM_HOME_CHANNEL=your_telegram_chat_id
TELEGRAM_HOME_CHANNEL_NAME=YourName

# OpenRouter (free tier model for cron)
OPENROUTER_API_KEY=your_openrouter_key_here

# Browser Use (optional)
BROWSER_USE_API_KEY=your_key_here

# ─────────────────────────────────────────────
# Profile Architecture
# ─────────────────────────────────────────────
# Profile name: jobgetter
# Location: ~/AppData/Local/hermes/profiles/jobgetter/
# Gateway: Telegram polling
# Cron: every 240m, model nvidia/nemotron-3-super-120b-a12b:free on openrouter
# Delivery: telegram (push to chat)
# Continuity: on (dedup across runs)
# Skills: career-ops-shared, career-ops-scan, career-ops-evaluate,
#         career-ops-pipeline, career-ops-followup, career-ops-tracker
# Workdir: ~/Documents/job-getter